{
  "name": "deions-crib",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Deion's Crib - a cribbage game with Game Boy-era visuals",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "play": "tsx src/cli/play.ts"
  },
  "devDependencies": {
    "@fontsource/press-start-2p": "^5.3.0",
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.21",
    "vite-plugin-pwa": "^2.0.0",
    "vitest": "^2.1.0"
  }
}
